# PostgreSQL inside Docker. Use only letters and numbers in the password so the URL stays valid.
POSTGRES_DB=openlivery
POSTGRES_TEST_DB=openlivery_test
POSTGRES_USER=openlivery
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Secrets unique to this installation. Do not reuse values across installations.
SECRET_KEY=CHANGE_THIS_SESSION_SECRET
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY
WHATSAPP_BRIDGE_TOKEN=CHANGE_THIS_INTERNAL_TOKEN

# UTC instant from which inbound messages may trigger AI/trial automation.
# This must be set explicitly; missing/invalid values fail closed.
TRIAL_ACTIVATION_ELIGIBLE_SINCE=2026-09-12T00:00:00+00:00

# The app and API are served from one origin through the gateway, so the browser
# uses relative "/api" calls — no public API URL to configure. FRONTEND_URL is
# only used by CORS if you expose the API on a separate origin.
FRONTEND_URL=http://localhost:3000

# Optional configuration.
ACCESS_TOKEN_MINUTES=10080
WHATSAPP_LOG_LEVEL=silent
# The instance is single-agency by default: the first registration creates the
# owner agency and closes public sign-up. Set to true only when one deployment
# must host many agencies.
# ALLOW_MULTI_AGENCY=false

# Session cookie flags. Behind an HTTPS reverse proxy set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Host ports. Change any that clash with other local services. WEB_PORT is the
# gateway (the app); API_PORT exposes the API locally for docs/tooling.
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
# Bind address: 127.0.0.1 (local only) or 0.0.0.0 (expose on a server).
BIND_HOST=127.0.0.1

# Portal verification: leave host/from empty until ready to send.
# Mailpit: host=localhost (or Docker network hostname), port=1025, TLS=false.
# Mailpit captures mail locally; username/password can remain empty.
# Production: provider STARTTLS port (usually 587), TLS=true.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10


# Google Calendar OAuth (create a Web application OAuth client in Google Cloud)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

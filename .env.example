# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://openlivery:openlivery@localhost:5432/openlivery

# Change these keys before using real data (at least 32 characters)
SECRET_KEY=change-this-long-random-key-in-production
ENCRYPTION_KEY=change-this-other-long-random-key

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Session cookie flags. Behind HTTPS set COOKIE_SECURE=true. If the frontend and
# API are on different sites, set COOKIE_SAMESITE=none (which requires
# COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# The instance is single-agency by default: the first registration creates the
# owner agency and closes public sign-up. Set to true only when one deployment
# must host many agencies.
# ALLOW_MULTI_AGENCY=false

# Public backend URL used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Baileys bridge. Use the same long random value in FastAPI and Node.
BACKEND_URL=http://localhost:8000
WHATSAPP_BRIDGE_URL=http://localhost:3101
WHATSAPP_BRIDGE_PORT=3101
WHATSAPP_BRIDGE_TOKEN=generate-a-long-random-token-for-the-bridge

# UTC instant from which inbound messages may trigger AI/trial automation.
# Leave unset/invalid only if automation must fail closed.
TRIAL_ACTIVATION_ELIGIBLE_SINCE=2026-09-12T00:00:00+00:00

# WhatsApp Cloud API (official Meta API). Channel credentials are configured
# per client in the UI; this only overrides the Graph API root (e.g. to pin a
# version or point at a mock in tests).
# META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0

# Portal verification: leave host/from empty until ready to send.
# Mailpit: host=localhost (or Docker network hostname), port=1025, TLS=false.
# Mailpit captures mail locally; username/password can remain empty.
# Production: provider STARTTLS port (usually 587), TLS=true.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
